# Copy to the CIRCUITPY drive as settings.toml and fill in.
# Up to three Wi-Fi networks, tried in order: yours for testing, Dad's for Christmas.
WIFI_SSID_1 = "your-wifi"
WIFI_PASSWORD_1 = "your-password"
WIFI_SSID_2 = "dads-wifi"
WIFI_PASSWORD_2 = "dads-password"

# Optional: the Portal finds the Pi by itself (the Pi broadcasts its address, and the Portal
# remembers the last one that worked). Only fill this in if discovery doesn't work on a network.
# DISPLAY_URLS = "http://192.168.1.50:8080/display.json"

POLL_SECONDS = 3

# 0 = normal. 1 = detailed log on the USB serial console (Mu, Thonny or `screen`).
# 2 = also replace the flight screen with a diagnostics screen (Wi-Fi, IPs, Pi status, last error).
DEBUG = 0

# 1 = airport-board flap animation when the screen changes, 0 = instant
FLAP = 1
